APP_ENV=development
APP_NAME=企业知识库问答
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/app.db
VECTOR_BACKEND=memory
POSTGRES_VECTOR_URL=postgresql+psycopg://rag:rag_password@localhost:5432/rag
VECTOR_COLLECTION=enterprise_knowledge

# OpenAI 或兼容 OpenAI 协议的模型服务
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# openai / fastembed / local_hash
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_CACHE_DIR=./data/model_cache
# 内存紧张的服务器（4G 左右）建议用本地轻量模型而不是大模型，见下面注释：
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIMENSIONS=512

DEFAULT_TENANT_ID=default
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_K=6
RETRIEVAL_FETCH_K=24
MAX_UPLOAD_MB=30
UPLOAD_DIR=./data/uploads

# 身份认证：开发环境使用固定身份；生产环境改为 oidc
AUTH_MODE=dev
DEV_USER_ID=local-admin
DEV_USER_NAME=本地管理员
DEV_TENANT_ID=default
DEV_GROUPS=admins,hr,finance
DEV_ROLES=admin,user
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_GROUPS_CLAIM=groups
OIDC_ROLES_CLAIM=roles

# 企业微信自建应用登录（AUTH_MODE=wecom）。CorpID/AgentId/Secret 在企业微信管理后台
# 的自建应用页面获取；WECOM_REDIRECT_URI 必须和后台配置的回调地址完全一致，且域名要
# 加入该应用的"可信域名"列表。WECOM_SESSION_SECRET 是本系统自己签发登录会话用的密钥，
# 随便生成一个足够长的随机字符串即可（不是企业微信给的），生产环境务必自己生成、不要用默认值。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://your-domain.example.com/api/auth/wecom/callback
WECOM_TENANT_ID=default
# 企业微信没有角色概念，只能按 userid 白名单手动认定管理员，逗号分隔
WECOM_ADMIN_USERIDS=
WECOM_SUPER_ADMIN_USERIDS=
WECOM_SESSION_SECRET=

# 云端部署走 --profile cloud 时，Caddy 反向代理用它申请 Let's Encrypt 证书；
# 需要先把这个域名解析到服务器公网 IP，且 80/443 端口可从公网访问
DOMAIN=

# 后台任务：开发可用 inprocess，生产建议 celery
TASK_BACKEND=inprocess
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 混合检索与生成
ENABLE_QUERY_REWRITE=true
LEXICAL_CANDIDATE_LIMIT=2000
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_LEXICAL_WEIGHT=0.35
# 重排候选数：候选越多越稳但 CPU 重排越慢（24→18 约提速 2 倍）；生产换 GPU 后可调回
RERANK_K=18
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2

# 安全与访问控制
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_ARCHIVE_ENTRIES=5000
MAX_ARCHIVE_UNCOMPRESSED_MB=200
REDACT_AUDIT_PII=true
RATE_LIMIT_PER_MINUTE=120
# 仅信任明确列出的反向代理 IP，之后才读取 X-Forwarded-For
TRUSTED_PROXY_IPS=
ALLOWED_ORIGINS=
RERANKER_PROVIDER=cross_encoder_api
# cross_encoder_api 使用兼容 Cohere/Infinity 的 POST /rerank 接口；失败时自动回退 token_overlap
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=http://reranker:7997
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=60
RERANKER_MAX_CHARS=256
CORRECTIVE_MIN_RERANK_SCORE=0.05
CACHE_URL=
RETRIEVAL_CACHE_TTL_SECONDS=300
# 检索管线（分块/混合/条文注入等）变更后递增，使旧检索缓存自动失效
RETRIEVAL_CACHE_VERSION=1
# 知识库无法回答时，是否回退到 LLM 通用回答（回答会明确标注非企业官方文档）
UNANSWERABLE_FALLBACK_ENABLED=true
UNANSWERABLE_FALLBACK_PREFIX=（以下内容为 AI 通用回答，不属于企业官方文档，仅供参考）
OCR_ENABLED=false
OCR_LANGUAGE=chi_sim+eng
CONNECTOR_ALLOWED_ROOTS=./connector_data

# 受控工具；生产中使用只读数据库账号
TOOL_DATABASE_URL=
TOOL_ALLOWED_TABLES=
TOOL_HTTP_ALLOWED_DOMAINS=
TOOL_HTTP_REQUIRE_HTTPS=true
TOOL_MAX_ROWS=200
TOOL_SQL_TIMEOUT_MS=10000
CHAT_FALLBACK_MODELS=

# 健康探测；模型探活默认关闭，避免健康检查产生外部请求
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2
HEALTH_CHECK_MODEL=false
SENSITIVE_CHAT_MODEL=
MAX_IMAGE_MEGAPIXELS=50
# 每百万 Token 单价由部署方维护，避免把易变价格写死在代码中
MODEL_PRICING_JSON={}
